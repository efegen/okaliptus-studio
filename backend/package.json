{
  "name": "yoga-studio-dashboard-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:bootstrap": "tsx scripts/bootstrap.ts",
    "smoke": "tsx scripts/smoke/run-all.ts",
    "smoke:single": "tsx scripts/smoke/run-all.ts --only",
    "smoke:reset": "tsx scripts/reset_db.ts && tsx src/db/migrate.ts && tsx scripts/bootstrap.ts && tsx scripts/smoke/run-all.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.0",
    "pg": "^8.13.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
