DATABASE_URL=postgresql://postgres:postgres@localhost:5432/yoga_studio_dashboard
PORT=4000
TZ=Europe/Istanbul
NODE_ENV=development

# CORS whitelist — comma-separated origins allowed to call the API with
# credentials. In production this MUST be set (e.g. https://okaliptus.com).
# In development, leave empty: backend falls back to localhost:5173 + 127.0.0.1:5173.
ALLOWED_ORIGINS=

# Bootstrap: instructor ve admin kullanıcıları oluşturmak için kullanılır.
# Gerçek değerleri .env'e yaz (.env gitignore'da, bu dosyayı değiştirme).
BOOTSTRAP_INSTRUCTOR_NAME=Instructor Name Here
BOOTSTRAP_ADMINS=username1:password1,username2:password2,username3:password3
# BOOTSTRAP_ADMINS içindeki bu kullanıcı adını 'owner' rolüne terfi eder
# (idempotent, asla düşürmez). Boş bırakılırsa kimse owner olmaz — kullanıcı
# yönetimi paneline erişecek ilk hesabı burada belirt.
BOOTSTRAP_OWNER_USERNAME=

# Web Push (PWA bildirimleri), opsiyonel. Abonelik (/push/subscribe) her role
# açık; yalnız /push/test (deploy-test özelliği) owner rolüne kilitli.
# Anahtarları üret: `npx web-push generate-vapid-keys`
# Boş bırakılırsa push özelliği tamamen kapalıdır.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Etap 4 — Bildirim zamanlayıcısı (ders hatırlatma / durum dürtmesi / yeni
# sipariş). VAPID anahtarları yoksa zamanlayıcı hiç başlamaz. 0 → devre dışı.
NOTIFICATION_SCHEDULER_MS=60000

# Trendyol Marketplace — YALNIZ sipariş OKUMA (read-only). Boş bırakılırsa
# sipariş önizleme ucu "yapılandırılmamış" döner; başka hiçbir şey etkilenmez.
# Base URL PROD varsayılan; STAGE testi için stageapigw ile override et:
#   TRENDYOL_API_BASE_URL=https://stageapigw.trendyol.com
# Kimlik: satıcı panelinden alınan API Key + Secret (Authorization: Basic).
TRENDYOL_API_BASE_URL=https://apigw.trendyol.com
TRENDYOL_SELLER_ID=
TRENDYOL_API_KEY=
TRENDYOL_API_SECRET=

# Web sitesi mağazası — sitenin build sırasında GET /site/products ucunu okuduğu
# anahtar (en az 32 karakter). Boş bırakılırsa uç kapalıdır (404). Sitenin
# build ortamında aynı değer olmalı. Üret: `openssl rand -hex 32`
SITE_FEED_TOKEN=

# Otomatik yenileme (bkz. site-refresh.service.ts). Panel her SITE_REFRESH_CHECK_MS'te
# (varsayılan 1 saat; 0 → kapalı) bakar: Trendyol listesi SITE_SYNC_INTERVAL_HOURS'tan
# (varsayılan 24; 0 → yalnız elle) eskiyse yeniler; sitenin listesi değiştiyse
# SITE_DEPLOY_HOOK_URL'ye (Cloudflare Pages deploy hook, gizli) haber verir.
SITE_REFRESH_CHECK_MS=3600000
SITE_SYNC_INTERVAL_HOURS=24
SITE_DEPLOY_HOOK_URL=
